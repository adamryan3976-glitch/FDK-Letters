# Copy this file to .env for local development, and fill in the values
# from Firebase Console > Project settings > General > Your apps > SDK setup.
# For the deployed (GitHub Pages) version, set these same values as
# repository secrets instead -- see README.md.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
