rules_version = '2';

// Every class document lives at users/{userId}/classes/{classId}.
// These rules say: you may only read or write documents nested under your
// own signed-in uid. There is no way for one teacher's browser to read or
// write another teacher's data, no matter what the client code sends.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/classes/{classId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
